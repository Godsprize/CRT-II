# Gate CFD public market data does not require an API key.
# GATE_CFD_BASE_URL=https://api.gateio.ws/api/v4/tradfi

# Create a bot with Telegram's BotFather, then add the bot token here.
TELEGRAM_BOT_TOKEN=your_bot_token

# Set either one chat ID or a comma-separated allowlist.
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_CHAT_IDS=your_chat_id,second_person_chat_id

# Exact signal IDs are retained across restarts to suppress duplicate alerts.
ALERT_HISTORY_PATH=work/alert-history.json
ALERT_HISTORY_RETENTION_DAYS=90
